{
  "manifest_version": 3,
  "name": "GlobalExam Auto-Answer",
  "version": "2.2.0",
  "description": "Répond aux QCM à votre place : coche la bonne réponse, pourcentage de réussite réglable. Pause entre les questions reglable.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.global-exam.com/*",
    "https://global-exam.com/*"
  ],
  "action": {
    "default_title": "GlobalExam Auto-Answer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.global-exam.com/*",
        "https://global-exam.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
